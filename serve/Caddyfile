# Caddy in front of Martin: tiles go to Martin, everything else (style, fonts,
# sprites, test page) is served from build/static. SITE_ADDRESS is ":8080"
# locally and behind another reverse proxy, or the maps domain when Caddy
# faces the internet and handles HTTPS itself. MARTIN_UPSTREAM is
# "localhost:3000" in the local pod and "martin:3000" under Docker Compose.

# Behind another reverse proxy, trust its X-Forwarded-Proto and Host so
# Martin writes https:// tile URLs into its TileJSON. Without this Caddy
# replaces them with its own plain-HTTP view, and native apps, which do not
# upgrade http:// like browsers with HSTS, load no tiles.
{
	servers {
		trusted_proxies static private_ranges
	}
}

{$SITE_ADDRESS::8080} {
	# Only Peakjar's sites and local development may use the map in a browser.
	# Native apps send no Origin and are not affected. Martin answers every
	# origin itself, so its header is dropped below and set here instead.
	@allowed_origin header_regexp Origin ^(https://(app\.)?peakjar\.com|https?://(localhost|127\.0\.0\.1|10\.\d+\.\d+\.\d+|192\.168\.\d+\.\d+)(:\d+)?)$
	header @allowed_origin Access-Control-Allow-Origin {http.request.header.Origin}
	header Vary Origin

	# Tiles and fonts change only with a new release; a CDN or the app's
	# cache can keep them for a day. The style is re-checked more often so
	# a release reaches clients quickly.
	header /tiles/* Cache-Control "public, max-age=86400"
	header /fonts/* Cache-Control "public, max-age=604800"
	header /sprites/* Cache-Control "public, max-age=86400"
	header /style/* Cache-Control "public, max-age=300"

	handle /tiles/* {
		reverse_proxy {$MARTIN_UPSTREAM:localhost:3000} {
			header_down -Access-Control-Allow-Origin
		}
	}

	handle {
		root * /srv
		file_server
	}
}
